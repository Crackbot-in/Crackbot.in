---
// Layout.astro - Root layout with theme system, SEO, accessibility
import '../styles/global.css';
import siteData from '../data/site.json';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteData.description } = Astro.props;
const site = siteData;
const canonical = new URL(Astro.url.pathname, Astro.site);

const pageTitle = title ? `${title} • ${site.name}` : `${site.name} • ${site.tagline}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline src="/scripts/theme.js"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} • Research Feed`} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>