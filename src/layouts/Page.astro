---
import Base from './Base.astro';
interface Props { title: string; label: string; heading: string; intro?: string; description?: string; }
const { title, label, heading, intro, description } = Astro.props;
---
<Base title={title} description={description ?? intro}>
  <header class="page-head">
    <div class="wrap">
      <p class="label">{label}</p>
      <h1>{heading}</h1>
      {intro && <p>{intro}</p>}
    </div>
  </header>
  <slot name="wide" />
  <div class="wrap article-body">
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>
