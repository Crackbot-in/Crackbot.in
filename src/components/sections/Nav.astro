---
// Nav.astro - Accessible navigation with theme toggle
import { Fragment } from 'astro/jsx-runtime';
import siteData from '../../data/site.json';

const site = siteData;

const links = [
  { href: '/research', label: 'Research' },
  { href: '/blog', label: 'Blog' },
  { href: '/tools', label: 'Tools' },
  { href: '/papers', label: 'Papers' },
  { href: '/team', label: 'Team' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-[var(--border-primary)] bg-[var(--bg-secondary)]/90 backdrop-blur-md safe-top no-print" role="banner">
  <nav class="container" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 group focus-visible rounded-lg nav-link active" aria-label={`${site.name} home`}>
        <span class="flex items-center gap-1.5 font-semibold text-lg tracking-tight text-[var(--text-primary)]">
          Crackbot
        </span>
        <span class="hidden sm:inline text-sm font-medium text-[var(--text-tertiary)] border-l border-[var(--border-primary)] pl-2.5">
          Research Group
        </span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="nav-link"
            class:list={[
              isActive(link.href) && 'active'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="moon-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg class="sun-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <button
        id="nav-toggle"
        type="button"
        class="md:hidden p-2 rounded-lg theme-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg class="w-5 h-5 nav-bars block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg class="nav-x hidden block w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="nav-menu" class="hidden md:hidden py-4 border-t border-[var(--border-primary)]" role="navigation" aria-label="Mobile navigation">
      <div class="flex flex-col gap-1">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="nav-link px-3 py-2.5"
            class:list={[isActive(link.href) && 'active']}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function updateThemeToggle(theme) {
    themeToggle.setAttribute('aria-pressed', theme === 'dark');
  }

  if (themeToggle && window.CrackbotTheme) {
    updateThemeToggle(window.CrackbotTheme.get());
    themeToggle.addEventListener('click', () => {
      window.CrackbotTheme.toggle();
      updateThemeToggle(window.CrackbotTheme.get());
    });
  }

  // Mobile nav toggle
  const navToggle = document.getElementById('nav-toggle');
  const navMenu = document.getElementById('nav-menu');
  const bars = navToggle?.querySelector('.nav-bars');
  const x = navToggle?.querySelector('.nav-x');

  navToggle?.addEventListener('click', () => {
    const open = navMenu?.classList.toggle('hidden') === false;
    navToggle.setAttribute('aria-expanded', String(open));
    bars?.classList.toggle('hidden', open);
    x?.classList.toggle('hidden', !open);
  });

  // Close mobile menu on link click
  navMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      navMenu.classList.add('hidden');
      navToggle.setAttribute('aria-expanded', 'false');
      bars?.classList.remove('hidden');
      x?.classList.add('hidden');
    });
  });
</script>