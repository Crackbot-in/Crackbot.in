---
// Philosophy.astro - Principles section with code block
import principlesData from '../../data/principles.json';

const { principles, codeBlock } = principlesData;
---

<section class="section bg-[var(--bg-tertiary)]" aria-labelledby="philosophy-heading">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-14">
      <h2 id="philosophy-heading" class="section-heading">Research Philosophy</h2>
      <p class="section-subheading mt-4">
        Eight immutable principles that gate every finding before publication.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
      {principles.map((p) => (
        <article class="card p-5">
          <p class="font-mono text-xs text-[var(--accent-primary)] mb-2">{p.id}</p>
          <h3 class="font-semibold text-sm text-[var(--text-primary)] mb-2">{p.title}</h3>
          <p class="text-xs text-[var(--text-tertiary)] leading-relaxed">{p.description}</p>
        </article>
      ))}
    </div>

    <div class="code-block">
      <div class="code-header">
        <div class="code-dots">
          <span class="code-dot" style="background: var(--error);"></span>
          <span class="code-dot" style="background: var(--warning);"></span>
          <span class="code-dot" style="background: var(--success);"></span>
        </div>
        <span class="font-mono text-xs text-[var(--text-quaternary)]">crackbot/principles.md</span>
      </div>
      <pre><code class="language-python">{codeBlock}</code></pre>
    </div>
  </div>
</section>