---
// FocusAreas.astro - Research domains grid section
import FocusCard from '../ui/FocusCard.astro';
import focusData from '../../data/focus-areas.json';
---

<section class="section" aria-labelledby="focus-areas-heading">
  <div class="container">
    <header class="text-center max-w-3xl mx-auto mb-14">
      <h2 id="focus-areas-heading" class="section-heading">Research Domains</h2>
      <p class="section-subheading mt-4">
        Each domain represents a pillar of our research approach. Areas marked
        <span class="badge badge-success">ACTIVE</span> have published work — others are in active development.
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {focusData.focusAreas.map((area, index) => (
        <FocusCard area={area} index={index} />
      ))}
    </div>
  </div>
</section>