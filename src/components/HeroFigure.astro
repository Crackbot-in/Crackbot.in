---
// Fig. 1: an intrusion path, animated with SVG (SMIL) + CSS only. No JavaScript.
// A marker travels the path; each step lights up as it passes; a cursor runs along the timeline.
// Animated layers carry class "anim" and are hidden for prefers-reduced-motion.
const dots: Array<[number, number]> = [];
for (let x = 20; x <= 540; x += 26) for (let y = 20; y <= 400; y += 26) dots.push([x, y]);

const boxes = [
  { x: 24, y: 48, k: 'initial access', v: 'invoice.lnk' },
  { x: 214, y: 48, k: 'execution', v: 'loader.dll' },
  { x: 404, y: 48, k: 'command & control', v: 'https/443', hot: true },
  { x: 404, y: 196, k: 'discovery', v: 'ad enumeration' },
  { x: 214, y: 196, k: 'lateral movement', v: 'smb / wmi' },
  { x: 24, y: 196, k: 'collection', v: 'staged archive' },
  { x: 214, y: 330, k: 'exfiltration', v: 'over c2 channel', hot: true },
];
const W = 132, H = 52;
const c = boxes.map((b) => ({ x: b.x + W / 2, y: b.y + H / 2 }));

// Marker route through the box centres (the last leg turns the corner like the drawn line).
const pts = [c[0], c[1], c[2], c[3], c[4], c[5], { x: c[5].x, y: c[6].y }, c[6]];
const route = pts.map((p, i) => `${i ? 'L' : 'M'}${p.x} ${p.y}`).join(' ');
const seg = pts.slice(1).map((p, i) => Math.hypot(p.x - pts[i].x, p.y - pts[i].y));
const total = seg.reduce((a, b) => a + b, 0);
const at: number[] = [0];
seg.forEach((s, i) => at.push(at[i] + s / total));
// time fraction at which the marker reaches each box (index 6 is the corner, skip it)
const boxT = [at[0], at[1], at[2], at[3], at[4], at[5], at[7]];
const DUR = '10s';
const flash = (t: number) => {
  const a = Math.min(0.98, Math.max(0.001, t - 0.02));
  const b = Math.min(0.99, a + 0.02);
  const cc = Math.min(0.998, b + 0.09);
  return { keyTimes: `0;${a.toFixed(4)};${b.toFixed(4)};${cc.toFixed(4)};1`, values: '0;0;1;0;0' };
};
---
<figure class="figure">
  <svg viewBox="0 0 560 470" role="img" aria-labelledby="fig1-title">
    <title id="fig1-title">Diagram of an intrusion moving from initial access to exfiltration.</title>
    {dots.map(([x, y]) => <circle cx={x} cy={y} r="1" class="fg-dot" />)}

    <path class="fg-line" d={`M${boxes[0].x + W} ${c[0].y} H${boxes[1].x}`} />
    <path class="fg-line" d={`M${boxes[1].x + W} ${c[1].y} H${boxes[2].x}`} />
    <path class="fg-line" d={`M${c[2].x} ${boxes[2].y + H} V${boxes[3].y}`} />
    <path class="fg-line" d={`M${boxes[3].x} ${c[3].y} H${boxes[4].x + W}`} />
    <path class="fg-line" d={`M${boxes[4].x} ${c[4].y} H${boxes[5].x + W}`} />
    <path class="fg-line" d={`M${c[5].x} ${boxes[5].y + H} V${c[6].y} H${boxes[6].x}`} />
    <path class="fg-path fg-flow" d={`M${boxes[6].x + W} ${c[6].y} H${c[2].x + 40} V${boxes[2].y + H}`} />

    {boxes.map((b, i) => (
      <g>
        <rect x={b.x} y={b.y} width={W} height={H} class={b.hot ? 'fg-box-hot' : 'fg-box'} />
        <rect x={b.x} y={b.y} width={W} height={H} class="fg-flash anim" opacity="0">
          <animate attributeName="opacity" dur={DUR} repeatCount="indefinite" calcMode="linear" {...flash(boxT[i])} />
        </rect>
        <text x={b.x + 10} y={b.y + 20} class="fg-dim">{b.k.toUpperCase()}</text>
        <text x={b.x + 10} y={b.y + 39} class={b.hot ? 'fg-text-hot' : 'fg-text'}>{b.v}</text>
      </g>
    ))}

    <g class="anim">
      <circle r="9" class="fg-halo">
        <animateMotion dur={DUR} repeatCount="indefinite" path={route} />
      </circle>
      <circle r="4" class="fg-node-hot">
        <animateMotion dur={DUR} repeatCount="indefinite" path={route} />
      </circle>
    </g>

    <path class="fg-faint" d="M24 436 H536" />
    {[0, 1, 2, 3, 4].map((i) => (
      <g>
        <path class="fg-line" d={`M${24 + i * 128} 430 V442`} />
        <text x={24 + i * 128} y="460" class="fg-dim" text-anchor={i === 0 ? 'start' : i === 4 ? 'end' : 'middle'}>
          {['T+0', 'T+14m', 'T+2h', 'T+19h', 'T+3d'][i]}
        </text>
      </g>
    ))}
    <path class="fg-cursor anim" d="M24 426 V446">
      <animateTransform attributeName="transform" type="translate" from="0 0" to="512 0" dur={DUR} repeatCount="indefinite" />
    </path>
  </svg>
  <figcaption><b>Fig. 1</b> An intrusion, step by step.</figcaption>
</figure>
