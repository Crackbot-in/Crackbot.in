---
// Fig. 1: an intrusion mapped to MITRE ATT&CK techniques, in the style of an incident write-up.
// A marker moves down the chain; each step lights up as it is reached; an alert fires at C2.
// SVG + CSS only, no JavaScript. Timing: 8s loop, steps reached every 1.5s (classes d0,d3,d6,d9,d12).
// IPs are from 203.0.113.0/24 (reserved for documentation).
const steps = [
  { id: 'T1566.001', name: 'Spearphishing attachment', art: 'invoice_0193.lnk', tactic: 'Initial access' },
  { id: 'T1204.002', name: 'User runs malicious file', art: 'rundll32.exe loader.dll,Start', tactic: 'Execution' },
  { id: 'T1071.001', name: 'C2 over HTTPS', art: '203.0.113.7:443  beacon every 60s', tactic: 'Command & control', alert: true },
  { id: 'T1560.001', name: 'Data staged in archive', art: 'C:\\ProgramData\\a.7z  412 MB', tactic: 'Collection' },
  { id: 'T1041', name: 'Exfiltration over C2', art: 'a.7z  to  203.0.113.7', tactic: 'Exfiltration' },
];
const X0 = 46, Y0 = 92, STEP = 80;
const railTop = Y0, railBottom = Y0 + STEP * (steps.length - 1);
---
<figure class="figure">
  <svg viewBox="0 0 560 470" role="img" aria-labelledby="fig1-title">
    <title id="fig1-title">An example intrusion in five steps, each labelled with its MITRE ATT&CK technique, with an alert raised at the command-and-control step.</title>
    <defs>
      <filter id="hero-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <rect class="art-bg" x="0" y="0" width="560" height="470" rx="6" />
    {Array.from({ length: 13 }, (_, i) => <path class="art-grid" d={`M${(i + 1) * 40} 44 V470`} />)}
    <text class="art-meta" x="22" y="28">INCIDENT RECONSTRUCTION</text>
    <text class="art-meta" x="538" y="28" text-anchor="end">MITRE ATT&amp;CK · EXAMPLE DATA</text>
    <path class="art-rule" d="M0 44 H560" />

    <path class="art-rail" d={`M${X0} ${railTop} V${railBottom}`} />
    <path class="art-rail-hot" d={`M${X0} ${railTop} V${railBottom}`} pathLength="1" />

    {steps.map((s, i) => {
      const y = Y0 + i * STEP;
      return (
        <g>
          <rect class={`art-card-hl d${i * 3}`} x="70" y={y - 30} width="472" height="64" rx="4" />
          <circle class="art-node" cx={X0} cy={y} r="8" />
          <circle class={`art-node-hot d${i * 3}`} cx={X0} cy={y} r="8" filter="url(#hero-glow)" />
          <text class="art-id" x="86" y={y - 8}>{s.id}</text>
          <text class="art-tactic" x="526" y={y - 8} text-anchor="end">{s.tactic.toUpperCase()}</text>
          <text class="art-name" x="86" y={y + 12}>{s.name}</text>
          <text class="art-artifact" x="86" y={y + 28}>{s.art}</text>
          {s.alert && (
            <g class={`art-alert d${i * 3 + 1}`}>
              <rect x="420" y={y + 4} width="106" height="22" rx="3" />
              <text x="473" y={y + 19} text-anchor="middle">ALERT RAISED</text>
            </g>
          )}
        </g>
      );
    })}

    <g class="anim">
      <circle class="art-packet" r="5" cx={X0} cy={railTop} filter="url(#hero-glow)">
        <animate attributeName="cy" values={`${railTop};${railBottom};${railBottom}`} keyTimes="0;0.75;1" dur="8s" repeatCount="indefinite" />
      </circle>
    </g>
  </svg>
  <figcaption><b>Fig. 1</b> An intrusion broken into MITRE ATT&amp;CK techniques, the way we write incidents up. Example data.</figcaption>
</figure>
