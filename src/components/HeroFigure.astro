---
// Fig. 1: a hex view of a sample being scanned by a detection rule.
// A scan band moves down the dump; matching bytes light up as it reaches them,
// and the rule below ticks off each string. SVG + CSS only, no JavaScript.
// Timing: 8s loop, 16 rows, so row i is reached at i * 0.5s (CSS classes d0..d15).

let s = 0x1badb002;
const rnd = () => { s ^= s << 13; s ^= s >>> 17; s ^= s << 5; return (s >>> 0) % 256; };

const ROWS = 16, COLS = 16;
const bytes: number[][] = Array.from({ length: ROWS }, () => Array.from({ length: COLS }, () => rnd()));

// planted content
const put = (r: number, c: number, arr: number[]) => arr.forEach((b, i) => (bytes[r][c + i] = b));
put(0, 0, [0x4d, 0x5a, 0x90, 0x00, 0x03, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0xff, 0xff, 0x00, 0x00]);
put(1, 0, [0xb8, 0, 0, 0, 0, 0, 0, 0, 0x40, 0, 0, 0, 0, 0, 0, 0]);
const url = [...'http://x.test'].map((ch) => ch.charCodeAt(0));
put(6, 3, url);
put(11, 5, [0x8b, 0x45, 0xf8, 0x33, 0xc1]);

const hits: Record<string, number> = {};
const mark = (r: number, c: number, n: number) => { for (let i = 0; i < n; i++) hits[`${r}:${c + i}`] = r; };
mark(0, 0, 2);
mark(6, 3, url.length);
mark(11, 5, 5);

const hex = (n: number) => n.toString(16).toUpperCase().padStart(2, '0');
const asc = (n: number) => (n >= 0x20 && n < 0x7f ? String.fromCharCode(n) : '.');

const TOP = 46, RH = 17, HX = 62, HW = 20.5, AX = 404, AW = 7.6;
const ruleY = 352;
const rule = [
  { t: 'rule loader_demo {', d: -1 },
  { t: '  strings:', d: -1 },
  { t: '    $mz  = { 4D 5A }', d: 0 },
  { t: '    $url = "http://"', d: 6 },
  { t: '    $xor = { 8B 45 ?? 33 C1 }', d: 11 },
  { t: '  condition: $mz at 0 and all of them', d: 14 },
  { t: '}', d: -1 },
];
---
<figure class="figure">
  <svg viewBox="0 0 560 480" role="img" aria-labelledby="fig1-title">
    <title id="fig1-title">A hex dump of a file being scanned by a detection rule; matching bytes are highlighted.</title>

    <rect x="0.5" y="0.5" width="559" height="318" class="hx-panel" />
    <path d="M0.5 26 H559.5" class="hx-rule" />
    <text x="12" y="17" class="hx-head">sample.bin</text>
    <text x="548" y="17" class="hx-head" text-anchor="end">4,096 bytes · scanning</text>

    <!-- scan band -->
    <g class="anim">
      <rect x="1" y={TOP - 12} width="558" height={RH} class="hx-band">
        <animateTransform attributeName="transform" type="translate" from="0 0" to={`0 ${ROWS * RH}`} dur="8s" repeatCount="indefinite" />
      </rect>
    </g>

    {bytes.map((row, r) => (
      <g>
        <text x="12" y={TOP + r * RH} class="hx-off">{(r * 16).toString(16).toUpperCase().padStart(4, '0')}</text>
        {row.map((b, c) => {
          const h = hits[`${r}:${c}`];
          return (
            <g>
              {h !== undefined && <rect x={HX + c * HW - 3} y={TOP + r * RH - 11} width="18" height="14" class={`hx-hit d${h}`} />}
              {h !== undefined && <rect x={AX + c * AW - 0.5} y={TOP + r * RH - 11} width={AW} height="14" class={`hx-hit d${h}`} />}
              <text x={HX + c * HW} y={TOP + r * RH} class={h !== undefined ? 'hx-byte hx-byte-hit' : 'hx-byte'}>{hex(b)}</text>
            </g>
          );
        })}
        <text x={AX} y={TOP + r * RH} class="hx-asc" textLength={COLS * AW} lengthAdjust="spacing">{row.map(asc).join('')}</text>
      </g>
    ))}

    <!-- rule -->
    {rule.map((l, i) => (
      <g>
        <text x="12" y={ruleY + i * 17} class="hx-code">{l.t}</text>
        {l.d >= 0 && (
          <text x="548" y={ruleY + i * 17} text-anchor="end" class={`hx-tick d${l.d}`}>{i === 5 ? 'MATCH' : 'found'}</text>
        )}
      </g>
    ))}
  </svg>
  <figcaption><b>Fig. 1</b> A detection rule finding the bytes it looks for inside a file.</figcaption>
</figure>
