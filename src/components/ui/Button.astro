---
// Button.astro - Reusable button component
import { Fragment } from 'astro/jsx-runtime';
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg' | 'icon';
  href?: string;
  target?: '_blank' | '_self';
  rel?: string;
  icon?: string;
  iconPosition?: 'left' | 'right';
  children: any;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const { variant = 'primary', size = 'md', href, target, rel, icon, iconPosition = 'left', children, class: className = '', type = 'button', disabled = false } = Astro.props;

const classes = [
  'btn',
  `btn-${variant}`,
  `btn-${size}`,
  className
].filter(Boolean).join(' ');

const isLink = !!href;
---

<Fragment>
  {isLink ? (
    <a
      href={href}
      target={target}
      rel={rel}
      class={classes}
      aria-disabled={disabled}
    >
      {icon && iconPosition === 'left' && <Icon name={icon} size="sm" />}
      {children}
      {icon && iconPosition === 'right' && <Icon name={icon} size="sm" />}
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      class={classes}
      aria-disabled={disabled}
    >
      {icon && iconPosition === 'left' && <Icon name={icon} size="sm" />}
      {children}
      {icon && iconPosition === 'right' && <Icon name={icon} size="sm" />}
    </button>
  )}
</Fragment>