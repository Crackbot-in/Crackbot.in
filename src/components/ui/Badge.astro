---
// Badge.astro - Status badge component
interface Props {
  variant: 'active' | 'building' | 'research' | 'planned' | 'neutral';
  pulse?: boolean;
  children: any;
}

const { variant, pulse = false, children } = Astro.props;

const variants = {
  active: 'badge-success',
  building: 'badge-warning',
  research: 'badge-primary',
  planned: 'badge-neutral',
  neutral: 'badge-neutral',
};
---

<span class:list={['badge', variants[variant], pulse && 'animate-pulse']}>
  {children}
</span>

<style>
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }
</style>