---
// Generated cover art for a research post (used when the post has no `cover` image).
// Dark "console" panel with one motif per topic, seeded by the post's slug:
//   vulnerabilities -> stack buffer overflowing into the return address
//   malware         -> byte-entropy graph with a packed section
//   intelligence    -> infrastructure graph, victim to C2
//   forensics       -> event timeline across process / file / network / registry
//   notes           -> ridgeline plot
// SVG + CSS only. Timing: 8s loop, .d0-.d15 = 0.5s steps.
interface Props { seed: string; topic: string; label?: string; }
const { seed, topic, label } = Astro.props;

let h = 2166136261;
for (const ch of seed) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619); }
const rand = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return ((h >>> 0) % 10000) / 10000; };
const id = ((h >>> 0) % 0xffffff).toString(16).toUpperCase().padStart(6, '0');
const glow = `glow-${id}`;
const W = 800, H = 500;
const f = (n: number) => n.toFixed(1);
const slot = (x: number, x0: number, x1: number) => Math.min(15, Math.max(0, Math.floor(((x - x0) / (x1 - x0)) * 14)));

// vulnerabilities
const cells = 9, cw = 66, cx0 = 104, cy = 196, ch = 104;
const regions = [
  { from: 0, to: 5, name: 'char buf[48]' },
  { from: 6, to: 6, name: 'canary' },
  { from: 7, to: 7, name: 'rbp' },
  { from: 8, to: 8, name: 'ret' },
];

// malware
const EX0 = 96, EX1 = 720, EY0 = 360, ES = 26;
const N = 56;
const packStart = Math.floor(N * (0.3 + rand() * 0.15));
const packEnd = Math.min(N - 9, packStart + 11 + Math.floor(rand() * 6));
const ent = Array.from({ length: N }, (_, i) => {
  if (i < 3) return 1 + rand();
  if (i >= packStart && i <= packEnd) return 7.7 + rand() * 0.25;
  if (i > N - 8) return 2.2 + rand() * 1.6;
  return 5.3 + rand() * 1.1;
});
const ex = (i: number) => EX0 + (i / (N - 1)) * (EX1 - EX0);
const entD = ent.map((e, i) => `${i ? 'L' : 'M'}${f(ex(i))} ${f(EY0 - e * ES)}`).join(' ');
const areaD = `${entD} L${EX1} ${EY0} L${EX0} ${EY0} Z`;

// intelligence
const nodes = Array.from({ length: 15 }, () => ({ x: 90 + rand() * 620, y: 130 + rand() * 240 }));
const edges: Array<[number, number]> = [];
nodes.forEach((n, i) => {
  nodes.map((m, j) => ({ j, d: (m.x - n.x) ** 2 + (m.y - n.y) ** 2 }))
    .filter((o) => o.j !== i).sort((a, b) => a.d - b.d).slice(0, 2)
    .forEach((o) => { if (i < o.j) edges.push([i, o.j]); });
});
const byX = nodes.map((n, i) => ({ ...n, i })).sort((a, b) => a.x - b.x);
const route: number[] = [byX[0].i];
for (let k = 0; k < 5; k++) {
  const cur = nodes[route[route.length - 1]];
  const next = nodes.map((m, j) => ({ j, m }))
    .filter(({ j, m }) => !route.includes(j) && m.x > cur.x)
    .sort((a, b) => ((a.m.x - cur.x) ** 2 + (a.m.y - cur.y) ** 2) - ((b.m.x - cur.x) ** 2 + (b.m.y - cur.y) ** 2))[0];
  if (!next) break;
  route.push(next.j);
}
const routeD = route.map((i, k) => `${k ? 'L' : 'M'}${f(nodes[i].x)} ${f(nodes[i].y)}`).join(' ');
const src = nodes[route[0]], dst = nodes[route[route.length - 1]];

// forensics
const lanes = ['process', 'file', 'network', 'registry'];
const TX0 = 200, TX1 = 720, LY0 = 160, LS = 60;
const events = lanes.flatMap((_, li) =>
  Array.from({ length: 4 + Math.floor(rand() * 3) }, () => ({ lane: li, x: TX0 + 12 + rand() * (TX1 - TX0 - 24) })),
);
const hotIdx = new Set([0, 1, 2, 3].map((li) => events.findIndex((e) => e.lane === li)));

// notes
const ridges = Array.from({ length: 9 }, (_, r) => {
  const base = 170 + r * 24;
  const amp = 24 + rand() * 46;
  const c = 0.38 + rand() * 0.24;
  const pts = Array.from({ length: 49 }, (_, i) => {
    const t = i / 48;
    const y = base - Math.exp(-((t - c) ** 2) / 0.014) * amp - Math.exp(-((t - c - 0.13) ** 2) / 0.004) * amp * 0.45 - rand() * 3;
    return `${i ? 'L' : 'M'}${f(100 + t * 600)} ${f(y)}`;
  }).join(' ');
  return { base, d: pts };
});
const hotRidge = 2 + Math.floor(rand() * 5);
---
<svg class={`plate plate-${topic}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <filter id={glow} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="5" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>
  <rect class="art-bg" x="0" y="0" width={W} height={H} />
  {Array.from({ length: 19 }, (_, i) => <path class="art-grid" d={`M${(i + 1) * 40} 0 V${H}`} />)}
  {Array.from({ length: 11 }, (_, i) => <path class="art-grid" d={`M0 ${(i + 1) * 40} H${W}`} />)}

  {topic === 'vulnerabilities' && (
    <g>
      <text class="art-code" x={cx0} y={cy - 44}>memcpy(buf, input, 72);</text>
      {Array.from({ length: cells }, (_, i) => (
        <g>
          <rect class="art-cell" x={cx0 + i * cw} y={cy} width={cw - 6} height={ch} />
          <rect class={`art-fill d${i + 1} ${i === cells - 1 ? 'art-fill-bad' : ''}`} x={cx0 + i * cw} y={cy} width={cw - 6} height={ch} filter={i === cells - 1 ? `url(#${glow})` : undefined} />
          <text class="art-big" x={cx0 + i * cw + (cw - 6) / 2} y={cy + ch / 2 + 8} text-anchor="middle">41</text>
        </g>
      ))}
      {regions.map((r) => (
        <g>
          <path class="art-tickline" d={`M${cx0 + r.from * cw} ${cy + ch + 16} H${cx0 + r.to * cw + cw - 6}`} />
          <text class="art-label" x={cx0 + r.from * cw} y={cy + ch + 40}>{r.name}</text>
        </g>
      ))}
      <text class="art-hot-text d10" x={cx0 + cells * cw - 6} y={cy + ch + 84} text-anchor="end" filter={`url(#${glow})`}>RIP = 0x4141414141414141</text>
    </g>
  )}

  {topic === 'malware' && (
    <g>
      <rect class="art-band-hot" x={ex(packStart)} y="110" width={ex(packEnd) - ex(packStart)} height={EY0 - 110} />
      <text class="art-label art-accent" x={ex(packStart) + 8} y="130">packed</text>
      <text class="art-label" x={EX0 + 8} y="130">.text</text>
      <text class="art-label" x={ex(N - 8) + 8} y="130">.rsrc</text>
      {[0, 4, 8].map((e) => (
        <g>
          <path class="art-tickline" d={`M${EX0} ${EY0 - e * ES} H${EX1}`} />
          <text class="art-label" x={EX0 - 14} y={EY0 - e * ES + 5} text-anchor="end">{e}</text>
        </g>
      ))}
      <path class="art-area" d={areaD} />
      <path class="art-hot-line art-draw" d={entD} pathLength="1" filter={`url(#${glow})`} />
      <text class="art-label" x={EX0} y={EY0 + 32}>entropy (bits per byte) across the file</text>
      <g class="anim">
        <path class="art-cursor" d={`M${EX0} 110 V${EY0}`}>
          <animateTransform attributeName="transform" type="translate" from="0 0" to={`${EX1 - EX0} 0`} dur="8s" repeatCount="indefinite" />
        </path>
      </g>
    </g>
  )}

  {topic === 'intelligence' && (
    <g>
      {edges.map(([a, b]) => <path class="art-edge" d={`M${f(nodes[a].x)} ${f(nodes[a].y)} L${f(nodes[b].x)} ${f(nodes[b].y)}`} />)}
      <path class="art-hot-line art-draw" d={routeD} pathLength="1" filter={`url(#${glow})`} />
      {[0, 1, 2].map((k) => <circle class={`art-ring p-pulse p-pulse-${k}`} cx={f(dst.x)} cy={f(dst.y)} r="46" />)}
      {nodes.map((n, i) => <circle class={route.includes(i) ? 'art-dot-hot' : 'art-dot'} cx={f(n.x)} cy={f(n.y)} r={route.includes(i) ? 6 : 4} />)}
      <text class="art-label" x={f(src.x)} y={f(src.y + 28)} text-anchor="middle">victim</text>
      <text class="art-label art-accent" x={f(dst.x)} y={f(dst.y + 30)} text-anchor="middle">c2</text>
    </g>
  )}

  {topic === 'forensics' && (
    <g>
      {lanes.map((name, li) => (
        <g>
          <text class="art-label" x="96" y={LY0 + li * LS + 5}>{name}</text>
          <path class="art-tickline" d={`M${TX0} ${LY0 + li * LS} H${TX1}`} />
        </g>
      ))}
      {events.map((e, k) => (
        <rect class={hotIdx.has(k) ? `art-evt art-evt-hot d${slot(e.x, TX0, TX1)}` : `art-evt d${slot(e.x, TX0, TX1)}`} x={f(e.x - 4)} y={LY0 + e.lane * LS - 16} width="8" height="32" rx="1" />
      ))}
      <g class="anim">
        <path class="art-cursor" d={`M${TX0} 126 V${LY0 + 3 * LS + 34}`} filter={`url(#${glow})`}>
          <animateTransform attributeName="transform" type="translate" from="0 0" to={`${TX1 - TX0} 0`} dur="8s" repeatCount="indefinite" />
        </path>
      </g>
    </g>
  )}

  {topic === 'notes' && (
    <g>
      {ridges.map((r, i) => (
        <g>
          <path class="art-occlude" d={`${r.d} L700 ${r.base + 30} L100 ${r.base + 30} Z`} />
          <path class={i === hotRidge ? 'art-hot-line art-draw' : 'art-ridge'} d={r.d} pathLength="1" filter={i === hotRidge ? `url(#${glow})` : undefined} />
        </g>
      ))}
    </g>
  )}

  <text class="art-meta" x="28" y={H - 28}>{(label ?? topic).toUpperCase()}</text>
  <text class="art-meta" x={W - 28} y={H - 28} text-anchor="end">CB-{id}</text>
</svg>
