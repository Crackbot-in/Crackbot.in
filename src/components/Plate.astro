---
// Cover art for a research post, generated at build time from its slug.
// Animated with CSS only: the highlighted route draws itself and the target pulses.
interface Props { seed: string; topic: string; label?: string; }
const { seed, topic, label } = Astro.props;

let h = 2166136261;
for (const ch of seed) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619); }
const rand = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return ((h >>> 0) % 10000) / 10000; };

const Wd = 800, Ht = 500;
const nodes = Array.from({ length: 26 }, () => ({ x: 40 + rand() * (Wd - 80), y: 40 + rand() * (Ht - 100) }));
const edges: Array<[number, number]> = [];
nodes.forEach((n, i) => {
  nodes
    .map((m, j) => ({ j, d: (m.x - n.x) ** 2 + (m.y - n.y) ** 2 }))
    .filter((o) => o.j !== i)
    .sort((a, b) => a.d - b.d)
    .slice(0, 2)
    .forEach((o) => { if (i < o.j) edges.push([i, o.j]); });
});
const sorted = nodes.map((n, i) => ({ ...n, i })).sort((a, b) => a.x - b.x);
const route: number[] = [sorted[0].i];
for (let k = 0; k < 5; k++) {
  const cur = nodes[route[route.length - 1]];
  const next = nodes
    .map((m, j) => ({ j, m }))
    .filter(({ j, m }) => !route.includes(j) && m.x > cur.x)
    .sort((a, b) => ((a.m.x - cur.x) ** 2 + (a.m.y - cur.y) ** 2) - ((b.m.x - cur.x) ** 2 + (b.m.y - cur.y) ** 2))[0];
  if (!next) break;
  route.push(next.j);
}
const hot = nodes[route[route.length - 1]];
const routeD = route.map((i, k) => `${k ? 'L' : 'M'}${nodes[i].x.toFixed(1)} ${nodes[i].y.toFixed(1)}`).join(' ');
const id = (h >>> 0).toString(16).slice(0, 6).toUpperCase();
---
<svg class={`plate plate-${topic}`} viewBox={`0 0 ${Wd} ${Ht}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {Array.from({ length: 9 }, (_, i) => <path class="p-grid" d={`M${(i + 1) * 80} 0 V${Ht}`} />)}
  {Array.from({ length: 5 }, (_, i) => <path class="p-grid" d={`M0 ${(i + 1) * 80} H${Wd}`} />)}
  {edges.map(([a, b]) => <path class="p-line" d={`M${nodes[a].x.toFixed(1)} ${nodes[a].y.toFixed(1)} L${nodes[b].x.toFixed(1)} ${nodes[b].y.toFixed(1)}`} />)}
  <path class="p-hot p-draw" d={routeD} pathLength="1" />
  {[0, 1, 2].map((k) => <circle class={`p-ring p-pulse p-pulse-${k}`} cx={hot.x.toFixed(1)} cy={hot.y.toFixed(1)} r="40" />)}
  {nodes.map((n, i) => <circle class={route.includes(i) ? 'p-dot-hot' : 'p-dot'} cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={route.includes(i) ? 4 : 2.5} />)}
  <text class="p-text" x="24" y={Ht - 22}>{(label ?? topic).toUpperCase()}</text>
  <text class="p-text" x={Wd - 24} y={Ht - 22} text-anchor="end">CB-{id}</text>
</svg>
