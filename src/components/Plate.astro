---
// Cover art. Modelled on how threat-research teams illustrate their work
// (Varonis, Unit 42, Talos): one large symbol per image, dark cinematic scene,
// a single accent colour with glow, and a brand stamp. No small labels or data.
//
//   brand           -> the Crackbot shield, light running along the crack (home page)
//   vulnerabilities -> a padlock split by a fracture
//   malware         -> a slowly turning virus particle
//   intelligence    -> a radar sweep picking up contacts
//   forensics       -> a magnifying glass scanning a fingerprint
//   notes           -> a terminal with a blinking cursor
//
// SVG + CSS only. The slug seeds small variations so covers don't look identical.
interface Props { seed: string; topic: string; label?: string; hero?: boolean; }
const { seed, topic, label, hero = false } = Astro.props;

let h = 2166136261;
for (const ch of seed) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619); }
const rand = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return ((h >>> 0) % 10000) / 10000; };
const uid = ((h >>> 0) % 0xffffff).toString(36);
const W = 800, H = 500, CX = 400, CY = 228;
const f = (n: number) => n.toFixed(1);

// perspective floor
const horizon = 352;
const floorV = Array.from({ length: 21 }, (_, i) => -800 + i * 120);
const floorH = Array.from({ length: 7 }, (_, k) => horizon + 4 + (k * k) * 3.4);

// radar contacts
const blips = Array.from({ length: 5 }, () => {
  const a = rand() * Math.PI * 2, r = 30 + rand() * 90;
  return { x: Math.cos(a) * r, y: Math.sin(a) * r };
});
// fingerprint arcs
const prints = Array.from({ length: 7 }, (_, i) => {
  const r = 10 + i * 9, gap = 0.3 + rand() * 0.9, start = rand() * Math.PI * 2;
  const a0 = start + gap, a1 = start + Math.PI * 2 - gap;
  const p = (a: number) => `${f(Math.cos(a) * r)} ${f(Math.sin(a) * r * 1.25)}`;
  return `M${p(a0)} A${r} ${f(r * 1.25)} 0 1 1 ${p(a1)}`;
});
const shield = 'M16 1 L29.5 5.5 V15.5 C29.5 23.6 24 28.9 16 31 C8 28.9 2.5 23.6 2.5 15.5 V5.5 Z';
const crack = 'M18 1.5 L13.2 13 L19 17.2 L14.8 30.5';
const spikes = Array.from({ length: 12 }, (_, i) => (i / 12) * Math.PI * 2 + rand() * 0.08);
---
<svg class={`plate plate-${topic}${hero ? ' plate-hero' : ''}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`halo-${uid}`} cx="50%" cy="46%" r="45%">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.32" />
      <stop offset="0.55" stop-color="currentColor" stop-opacity="0.06" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`floor-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d0f13" stop-opacity="1" />
      <stop offset="1" stop-color="#0d0f13" stop-opacity="0" />
    </linearGradient>
    <filter id={`glow-${uid}`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <clipPath id={`lens-${uid}`}><circle cx="-24" cy="-24" r="74" /></clipPath>
  </defs>

  <rect class="art-bg" x="0" y="0" width={W} height={H} />
  <rect x="0" y="0" width={W} height={H} fill={`url(#halo-${uid})`} />

  <!-- floor -->
  <g class="art-floor">
    {floorV.map((x) => <path d={`M${CX} ${horizon - 40} L${x + CX} ${H + 40}`} />)}
    {floorH.map((y) => <path d={`M0 ${f(y)} H${W}`} />)}
  </g>
  <rect x="0" y={horizon - 40} width={W} height="90" fill={`url(#floor-${uid})`} />

  <!-- pulse rings behind the subject -->
  {[0, 1, 2].map((k) => <circle class={`art-ring p-pulse p-pulse-${k}`} cx={CX} cy={CY} r="150" />)}

  <g transform={`translate(${CX} ${CY})`} filter={`url(#glow-${uid})`}>
    {topic === 'brand' && (
      <g transform="translate(-112 -112) scale(7)">
        <path class="em-fill em-stroke" d={shield} vector-effect="non-scaling-stroke" />
        <path class="em-crack-base em-brand-base" d={crack} />
        <path class="em-crack-glow em-brand-glow" d={crack} />
        <path class="em-crack-run em-brand-run" d={crack} pathLength="1" />
      </g>
    )}

    {topic === 'vulnerabilities' && (
      <g>
        <path class="em-stroke em-shackle" d="M-52 -18 V-62 A52 52 0 0 1 52 -62 V-18" />
        <rect class="em-fill em-stroke" x="-84" y="-22" width="168" height="134" rx="14" />
        <circle class="em-solid" cx="0" cy="34" r="13" />
        <path class="em-solid" d="M-6 40 H6 L9 76 H-9 Z" />
        <path class="em-crack-base em-crack-wide" d="M14 -22 L-10 18 L16 52 L-6 112" />
        <path class="em-crack-glow" d="M14 -22 L-10 18 L16 52 L-6 112" />
        <path class="em-crack-run" d="M14 -22 L-10 18 L16 52 L-6 112" pathLength="1" />
      </g>
    )}

    {topic === 'malware' && (
      <g class="em-spin">
        {spikes.map((a) => (
          <g>
            <path class="em-stroke" d={`M${f(Math.cos(a) * 66)} ${f(Math.sin(a) * 66)} L${f(Math.cos(a) * 104)} ${f(Math.sin(a) * 104)}`} />
            <circle class="em-solid" cx={f(Math.cos(a) * 110)} cy={f(Math.sin(a) * 110)} r="9" />
          </g>
        ))}
        <circle class="em-fill em-stroke" cx="0" cy="0" r="66" />
        <circle class="em-stroke-thin" cx="-18" cy="-14" r="16" />
        <circle class="em-stroke-thin" cx="22" cy="10" r="11" />
        <circle class="em-stroke-thin" cx="-6" cy="28" r="8" />
      </g>
    )}

    {topic === 'intelligence' && (
      <g>
        {[44, 88, 132].map((r) => <circle class="em-stroke-thin" cx="0" cy="0" r={r} />)}
        <path class="em-stroke-thin" d="M-140 0 H140 M0 -140 V140" />
        <g class="em-sweep">
          <path class="em-wedge" d="M0 0 L132 0 A132 132 0 0 0 93.3 -93.3 Z" />
          <path class="em-stroke" d="M0 0 L132 0" />
        </g>
        {blips.map((b, i) => <circle class={`em-solid em-blip d${(i * 3) % 16}`} cx={f(b.x)} cy={f(b.y)} r="6" />)}
        <circle class="em-solid" cx="0" cy="0" r="5" />
      </g>
    )}

    {topic === 'forensics' && (
      <g>
        <g class="em-drift">
          <g clip-path={`url(#lens-${uid})`}>
            {prints.map((d) => <path class="em-print" d={d} transform="translate(-24 -24)" />)}
            <rect class="em-scan" x="-100" y="-100" width="152" height="6" />
          </g>
          <circle class="em-stroke" cx="-24" cy="-24" r="74" />
          <path class="em-handle" d="M30 30 L104 104" />
        </g>
      </g>
    )}

    {topic === 'notes' && (
      <g>
        <rect class="em-fill em-stroke" x="-140" y="-92" width="280" height="184" rx="10" />
        <path class="em-stroke-thin" d="M-140 -60 H140" />
        {[0, 1, 2].map((i) => <circle class="em-solid" cx={-118 + i * 18} cy="-76" r="5" />)}
        <text class="em-prompt" x="-112" y="22">&gt;</text>
        <rect class="em-solid em-blink" x="-74" y="-6" width="26" height="36" />
      </g>
    )}
  </g>

  <!-- stamps -->
  {!hero && <text class="art-meta" x="32" y="44">{(label ?? topic).toUpperCase()}</text>}
  {!hero && (
    <g transform={`translate(32 ${H - 56})`}>
      <g transform="scale(0.8)">
        <path class="em-stamp" d={shield} />
        <path class="em-stamp-crack" d={crack} />
      </g>
      <text class="art-brand" x="36" y="19">CRACKBOT</text>
    </g>
  )}
</svg>
