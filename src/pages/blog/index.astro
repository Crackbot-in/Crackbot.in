---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog"
  description="Technical analysis from the Crackbot research group — vulnerability deep-dives, malware analysis, forensics walkthroughs and tooling write-ups."
>
  <section class="section" aria-labelledby="blog-heading">
    <div class="container">
      <header class="text-center max-w-3xl mx-auto mb-14">
        <h1 id="blog-heading" class="section-heading">Research Blog</h1>
        <p class="section-subheading mt-4">
          Technical analysis when it's ready — vulnerability deep-dives, malware behavior, forensics and tooling.
          Subscribe via <a href="/rss.xml" class="link">RSS</a>.
        </p>
      </header>

      <div class="grid gap-6">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="card group p-6 sm:p-7">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <time class="text-xs font-mono text-[var(--text-quaternary)]" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
              </time>
            </div>
            <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-2 group-hover:text-[var(--accent-primary)] transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{post.data.description}</p>
          </a>
        ))}
        {posts.length === 0 && (
          <p class="text-center text-[var(--text-tertiary)] py-12">No posts yet — check back soon.</p>
        )}
      </div>
    </div>
  </section>
</Layout>