---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const site = siteData;
---

<Layout
  title="Papers"
  description="Research papers, white papers, and technical publications from the Crackbot research group."
>
  <section class="section" aria-labelledby="papers-heading">
    <div class="container">
      <header class="text-center max-w-3xl mx-auto mb-14">
        <h1 id="papers-heading" class="section-heading">Research Papers</h1>
        <p class="section-subheading mt-4">
          In-depth technical publications, white papers, and formal research from our group.
        </p>
      </header>

      <div class="max-w-3xl mx-auto">
        <div class="card p-8 text-center">
          <svg class="w-16 h-16 mx-auto mb-6 text-[var(--text-quaternary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-3">Coming Soon</h2>
          <p class="text-[var(--text-secondary)] mb-6 max-w-md mx-auto">
            Our first research papers are in progress. We're preparing white papers on threat intelligence methodologies, vulnerability research frameworks, and AI-assisted security workflows.
          </p>
          <a href="/blog" class="btn btn-primary">Read Our Blog Instead</a>
        </div>

        <div class="mt-10 grid sm:grid-cols-2 gap-4">
          {[
            { title: 'Threat Intelligence Methodologies', status: 'In Progress', desc: 'Framework for systematic threat actor tracking and IOC enrichment.' },
            { title: 'Vulnerability Research Frameworks', status: 'Planned', desc: 'Reproducible methodology for web and API vulnerability discovery.' },
            { title: 'AI-Assisted Security Workflows', status: 'Research', desc: 'Evaluating LLM capabilities for automated triage and report generation.' },
            { title: 'Forensic Artifact Analysis', status: 'Planned', desc: 'Novel techniques for Windows and Linux artifact interpretation.' },
          ].map((paper) => (
            <article class="card p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="tag">{paper.status}</span>
              </div>
              <h3 class="font-semibold text-[var(--text-primary)] mb-1">{paper.title}</h3>
              <p class="text-sm text-[var(--text-tertiary)]">{paper.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>