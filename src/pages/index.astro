---
import Base from '../layouts/Base.astro';
import HeroFigure from '../components/HeroFigure.astro';
import Plate from '../components/Plate.astro';
import ResearchList from '../components/ResearchList.astro';
import { SITE, TOPICS, PRINCIPLES, type TopicKey } from '../data/site';
import { getResearch, formatDate, readingTime } from '../data/research';

const posts = await getResearch();
const [lead, ...rest] = posts;
const areas: TopicKey[] = ['vulnerabilities', 'malware', 'intelligence', 'forensics'];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="label">Security research group &amp; think tank</p>
        <h1>Security research, shared with the <em>community.</em></h1>
        <p class="lede">We are a group of people who work in cyber security. We research vulnerabilities, malware and threat activity, and publish what we learn so others can use it.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/research/">Read the research</a>
          <a class="btn btn-ghost" href="/disclosure/">Disclosure policy</a>
        </div>
      </div>
      <HeroFigure />
    </div>
  </section>

  <section class="wrap section" aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest">Latest</h2>
      <a href="/research/">All research</a>
    </div>
    {lead && (
      <a class="feature" href={`/research/${lead.id}/`}>
        <Plate seed={lead.id} topic={lead.data.topic} label={TOPICS[lead.data.topic].short} />
        <div>
          <div class="meta">
            <span class={`topic topic-${lead.data.topic}`}>{TOPICS[lead.data.topic].short}</span>
            <span>{formatDate(lead.data.date)}</span>
            <span>{readingTime(lead.body)}</span>
          </div>
          <h3>{lead.data.title}</h3>
          <p>{lead.data.summary}</p>
        </div>
      </a>
    )}
    {rest.length > 0 && <div class="section"><ResearchList items={rest.slice(0, 5)} /></div>}
  </section>

  <section class="wrap section" aria-labelledby="areas">
    <div class="section-head">
      <h2 id="areas">What we look at</h2>
    </div>
    <div class="areas">
      {areas.map((key, i) => (
        <div class="area">
          <span class="num">0{i + 1}</span>
          <span class={`swatch sw-${key}`}></span>
          <h3><a href={`/research/topic/${key}/`}>{TOPICS[key].label}</a></h3>
          <p>{TOPICS[key].blurb}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="how">
    <div class="section-head">
      <h2 id="how">How we work</h2>
      <a href="/about/">About us</a>
    </div>
    <div class="principles">
      {PRINCIPLES.map((p) => (
        <div class="principle">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="band" aria-label="Disclosure">
    <div class="wrap">
      <div class="band-cell">
        <p class="label">Vendors</p>
        <h2>Found something in your product?</h2>
        <p>If we find a vulnerability, including a zero-day, we report it to you privately first and give you time to fix it.</p>
        <a class="more" href="/disclosure/">Disclosure policy</a>
      </div>
      <div class="band-cell">
        <p class="label">Researchers</p>
        <h2>Found something in ours?</h2>
        <p>Email <a href={`mailto:${SITE.securityEmail}`}>{SITE.securityEmail}</a>. We will look into it and credit you if you would like.</p>
        <a class="more" href="/.well-known/security.txt">security.txt</a>
      </div>
    </div>
  </section>
</Base>
