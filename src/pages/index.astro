---
import Base from '../layouts/Base.astro';
import HeroFigure from '../components/HeroFigure.astro';
import Plate from '../components/Plate.astro';
import ResearchList from '../components/ResearchList.astro';
import { TOPICS, PRINCIPLES, IN_PROGRESS, type TopicKey } from '../data/site';
import { getResearch, formatDate, readingTime } from '../data/research';

const posts = await getResearch();
const [lead, ...rest] = posts;
const areas: TopicKey[] = ['vulnerabilities', 'malware', 'intelligence', 'forensics'];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="label">Independent security research</p>
        <h1>We take threats apart so defenders don’t have to <em>guess.</em></h1>
        <p class="lede">
          Crackbot is a small group of security researchers. We study vulnerabilities, malware and the
          infrastructure attackers rely on, then write up what we find in plain language, with the evidence attached.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/research/">Read the research</a>
          <a class="btn btn-ghost" href="/disclosure/">Report a vulnerability</a>
        </div>
      </div>
      <HeroFigure />
    </div>
  </section>

  <section class="wrap section" aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest">Latest</h2>
      <a href="/research/">All research →</a>
    </div>
    {lead && (
      <a class="feature" href={`/research/${lead.id}/`}>
        <Plate seed={lead.id} topic={lead.data.topic} label={TOPICS[lead.data.topic].short} />
        <div>
          <div class="meta">
            <span class={`topic topic-${lead.data.topic}`}>{TOPICS[lead.data.topic].short}</span>
            <span>{lead.data.kind}</span>
            <span>{formatDate(lead.data.date)}</span>
            <span>{readingTime(lead.body)}</span>
          </div>
          <h3>{lead.data.title}</h3>
          <p>{lead.data.summary}</p>
        </div>
      </a>
    )}
    {rest.length > 0 && <div class="section"><ResearchList items={rest.slice(0, 5)} /></div>}
  </section>

  <section class="wrap section" aria-labelledby="areas">
    <div class="section-head">
      <h2 id="areas">What we work on</h2>
    </div>
    <div class="areas">
      {areas.map((key, i) => (
        <div class="area">
          <span class="num">0{i + 1}</span>
          <span class={`swatch sw-${key}`}></span>
          <h3><a href={`/research/topic/${key}/`}>{TOPICS[key].label}</a></h3>
          <p>{TOPICS[key].blurb}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="how">
    <div class="section-head">
      <h2 id="how">How we work</h2>
      <a href="/about/">About the group →</a>
    </div>
    <div class="principles">
      {PRINCIPLES.map((p) => (
        <div class="principle">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="building">
    <div class="section-head">
      <h2 id="building">On the bench</h2>
    </div>
    <p class="statement">We’re a new group, and we’d rather say so than pretend otherwise. <span>This is what we’re building before the first long reports go out.</span></p>
    <div class="building section">
      {IN_PROGRESS.map((b) => (
        <div>
          <h3>{b.name}</h3>
          <p>{b.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="band" aria-label="Disclosure">
    <div class="wrap">
      <div class="band-cell">
        <p class="label">For vendors</p>
        <h2>Heard from us about a bug?</h2>
        <p>Our reports come with a timeline, reproduction steps and a named contact. Here’s what to expect, and how we handle extensions.</p>
        <a class="more" href="/disclosure/">Read the disclosure policy →</a>
      </div>
      <div class="band-cell">
        <p class="label">For researchers</p>
        <h2>Found something in ours?</h2>
        <p>If you’ve found a problem with this site or anything we publish, tell us. We’ll acknowledge it, fix it, and credit you if you’d like.</p>
        <a class="more" href="/.well-known/security.txt">security.txt →</a>
      </div>
    </div>
  </section>
</Base>
