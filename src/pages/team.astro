---
import Layout from '../layouts/Layout.astro';
import siteData from '../data/site.json';

const site = siteData;
---

<Layout
  title="Team"
  description="The researchers, analysts, and engineers behind Crackbot — meet the team building independent cybersecurity research."
>
  <section class="section" aria-labelledby="team-heading">
    <div class="container">
      <header class="text-center max-w-3xl mx-auto mb-14">
        <h1 id="team-heading" class="section-heading">The Team</h1>
        <p class="section-subheading mt-4">
          A collaborative group of researchers, analysts and engineers. We keep a low profile until the work speaks.
        </p>
      </header>

      <div class="max-w-4xl mx-auto">
        <div class="card p-8 md:p-10 text-center mb-12">
          <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-[var(--accent-primary-light)] flex items-center justify-center">
            <svg class="w-12 h-12 text-[var(--accent-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-3">Team Crackbot</h2>
            <p class="text-[var(--text-secondary)] max-w-2xl mx-auto">
              We operate across vulnerability research, malware analysis, DFIR, and applied AI. Individual profiles are published alongside the first attributed research releases.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {[
              { name: 'Shivam', handle: '5h1Vm', role: 'Founder & Lead Researcher', domains: ['Vuln Research', 'AI Security'], bio: 'Building Crackbot from the ground up. Focused on web/API security and AI-assisted workflows.' },
              { name: 'Deepanshu Sharma', handle: 'anshu129', role: 'Malware Analyst', domains: ['Malware Research', 'DFIR'], bio: 'Static/dynamic malware analysis, YARA rule development, and forensic artifact parsing.' },
              { name: 'CrackB0t', handle: 'CrackB0t', role: 'Threat Intelligence', domains: ['Threat Intel', 'OSINT'], bio: 'APT tracking, IOC enrichment, underground forum monitoring, and advisory publication.' },
              { name: 'Digvijay Singh', handle: 'roblox-codex', role: 'Security Engineer', domains: ['Tool Dev', 'Automation'], bio: 'Building the Crackbot Framework, IOC collectors, and forensic tooling pipelines.' },
            ].map((member) => (
              <article class="card p-5 text-center group">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[var(--bg-tertiary)] border border-[var(--border-primary)] flex items-center justify-center group-hover:border-[var(--accent-primary)]/50 group-hover:bg-[var(--accent-primary-light)] transition-all duration-300">
                  <svg class="w-8 h-8 text-[var(--text-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h18a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-[var(--text-primary)]">{member.name}</h3>
                <p class="text-xs text-[var(--accent-primary)] font-mono mb-1">@{member.handle}</p>
                <p class="text-xs text-[var(--text-tertiary)] font-medium mb-2">{member.role}</p>
                <div class="flex flex-wrap justify-center gap-1 mb-3">
                  {member.domains.map((d) => (
                    <span class="tag text-[10px] px-1.5 py-0.5">{d}</span>
                  ))}
                </div>
                <p class="text-xs text-[var(--text-tertiary)]">{member.bio}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>