---
import Layout from '../layouts/Layout.astro';
import toolsData from '../data/tools.json';
import siteData from '../data/site.json';

const site = siteData;
const tools = toolsData.tools;

const statusConfig = {
  'in-development': { label: 'IN DEVELOPMENT', variant: 'warning' },
  'released': { label: 'RELEASED', variant: 'success' },
  'planned': { label: 'PLANNED', variant: 'neutral' },
};
---

<Layout
  title="Tools"
  description="Open-source security tools by Crackbot — scanners, parsers, forensic artifact tooling and automation frameworks, released under permissive licenses."
>
  <section class="section" aria-labelledby="tools-heading">
    <div class="container">
      <header class="text-center max-w-3xl mx-auto mb-14">
        <h1 id="tools-heading" class="section-heading">Open Source Tools</h1>
        <p class="section-subheading mt-4">
          Production-grade security tooling released under permissive licenses.
          Scanners, parsers, analyzers and automation frameworks — stable, scriptable, and documented.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2">
        {tools.map((tool) => {
          const status = statusConfig[tool.status] ?? statusConfig.planned;
          return (
            <article class="card group p-6 sm:p-7">
              <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[var(--accent-primary)]/30 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="relative flex-shrink-0 w-12 h-12 rounded-xl bg-[var(--bg-tertiary)] border border-[var(--border-primary)] flex items-center justify-center group-hover:border-[var(--accent-primary)]/50 group-hover:bg-[var(--accent-primary-light)] transition-all duration-300">
                  <svg class="w-5 h-5 text-[var(--accent-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class:list={['badge', `badge-${status.variant}`]}>{status.label}</span>
              </div>
              <h2 class="text-xl font-semibold text-[var(--text-primary)] mb-3">{tool.name}</h2>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">{tool.description}</p>
              <div class="flex flex-wrap items-center gap-2">
                {tool.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </article>
          );
        })}
      </div>

      <div class="mt-14 text-center">
        <p class="text-[var(--text-tertiary)]">
          Tools are released on our GitHub as they reach production quality.
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="link ml-2">Watch the org →</a>
        </p>
      </div>
    </div>
  </section>
</Layout>