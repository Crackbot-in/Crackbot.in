---
import Layout from '../layouts/Layout.astro';
import focusData from '../data/focus-areas.json';
import Icon from '../components/ui/Icon.astro';

const areas = focusData.focusAreas;
---

<Layout
  title="Research"
  description="Crackbot research domains — threat intelligence, vulnerability research, digital forensics, malware analysis, AI-assisted security, and OSINT."
>
  <section class="section" aria-labelledby="research-heading">
    <div class="container">
      <header class="text-center max-w-3xl mx-auto mb-14">
        <h1 id="research-heading" class="section-heading">Research Domains</h1>
        <p class="section-subheading mt-4">
          Each domain represents a pillar of our research approach. Areas marked
          <span class="badge badge-success">ACTIVE</span> have published work — others are in active development.
        </p>
      </header>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {areas.map((area) => (
          <article class="card group p-6 sm:p-7 lg:p-8">
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[var(--accent-primary)]/30 to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />
            <div class="flex items-start gap-4 sm:gap-5">
              <div class="relative flex-shrink-0 w-14 h-14 rounded-xl bg-[var(--bg-tertiary)] border border-[var(--border-primary)] flex items-center justify-center group-hover:border-[var(--accent-primary)]/50 group-hover:bg-[var(--accent-primary-light)] transition-all duration-300">
                <Icon name={area.icon} size="lg" class="text-[var(--accent-primary)]" />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h2 class="text-lg font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">{area.title}</h2>
                  <span class:list={['badge', area.status === 'active' ? 'badge-success' : area.status === 'building' ? 'badge-warning' : area.status === 'research' ? 'badge-primary' : 'badge-neutral']}>
                    {area.status.toUpperCase()}
                  </span>
                </div>
                <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">{area.description}</p>
                <div class="flex flex-wrap gap-1.5">
                  {area.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-14 text-center">
        <p class="text-[var(--text-tertiary)]">
          Interested in collaborating on any of these domains?
          <a href="/contact" class="link ml-2">Get in touch →</a>
        </p>
      </div>
    </div>
  </section>
</Layout>