---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Contact" description="How to reach Crackbot.">
  <header class="page-head">
    <div class="wrap">
      <p class="label">Contact</p>
      <h1>Get in touch</h1>
      <p>Email is the best way to reach us.</p>
    </div>
  </header>
  <div class="wrap">
    <div class="contact-grid">
      <div>
        <p class="label">Support</p>
        <h2>General</h2>
        <p>Questions, collaboration, or anything else.</p>
        <a class="addr" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <div>
        <p class="label">Research</p>
        <h2>Security reports</h2>
        <p>Vulnerability reports and research enquiries.<br />
        See the <a href="/disclosure/">disclosure policy</a>.</p>
        <a class="addr" href={`mailto:${SITE.securityEmail}`}>{SITE.securityEmail}</a>
      </div>
      <div>
        <p class="label">Code</p>
        <h2>GitHub</h2>
        <p>Our public repositories and tools.</p>
        <a class="addr" href={SITE.github} rel="noopener noreferrer">github.com/{SITE.githubHandle}</a>
      </div>
    </div>
  </div>
</Base>
